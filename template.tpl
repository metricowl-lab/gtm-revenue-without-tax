___TESTS___

scenarios:
- name: Removes 20% VAT
  code: |-
    assertThat(runCode({amount: '120', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(100);
- name: Returns the VAT instead
  code: |-
    assertThat(runCode({amount: 120, mode: 'rate', rate: 20, output: 'tax', decimals: 2})).isEqualTo(20);
- name: Rounds to two decimal places
  code: |-
    assertThat(runCode({amount: '49.99', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(41.66);
    assertThat(runCode({amount: '49.99', mode: 'rate', rate: '20', output: 'tax', decimals: '2'})).isEqualTo(8.33);
- name: Subtracts a tax amount
  code: |-
    assertThat(runCode({amount: '59.99', mode: 'taxValue', taxValue: '10', output: 'net', decimals: '2'})).isEqualTo(49.99);
    assertThat(runCode({amount: '59.99', mode: 'taxValue', taxValue: '10', output: 'tax', decimals: '2'})).isEqualTo(10);
- name: Other rates, such as Canadian HST at 13%
  code: |-
    assertThat(runCode({amount: '113', mode: 'rate', rate: '13', output: 'net', decimals: '2'})).isEqualTo(100);
    assertThat(runCode({amount: '50', mode: 'rate', rate: '0', output: 'net', decimals: '2'})).isEqualTo(50);
- name: Refunds stay negative and round the same way
  code: |-
    assertThat(runCode({amount: '-49.99', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(-41.66);
- name: Missing or non-numeric values return undefined
  code: |-
    assertThat(runCode({amount: '', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: undefined, mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '£120', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '120', mode: 'taxValue', taxValue: '', output: 'net', decimals: '2'})).isUndefined();
- name: Half pennies round correctly at 20%
  code: |-
    assertThat(runCode({amount: '10.29', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(8.58);
    assertThat(runCode({amount: '10.29', mode: 'rate', rate: '20', output: 'tax', decimals: '2'})).isEqualTo(1.71);
- name: Net and tax add back up to the amount
  code: |-
    assertThat(runCode({amount: '10.17', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(8.48);
    assertThat(runCode({amount: '10.17', mode: 'rate', rate: '20', output: 'tax', decimals: '2'})).isEqualTo(1.69);
- name: Very large decimal settings are capped
  code: |-
    assertThat(runCode({amount: '120', mode: 'rate', rate: '20', output: 'net', decimals: '400'})).isEqualTo(100);
    assertThat(runCode({amount: '120', mode: 'rate', rate: '20', output: 'net', decimals: '2.5'})).isEqualTo(100);
- name: Blank, true/false and overflowing values return undefined
  code: |-
    assertThat(runCode({amount: ' ', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: true, mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '1e308', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '1e400', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '0x10', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: '12 GBP', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isUndefined();
    assertThat(runCode({amount: ' 1.2e1 ', mode: 'rate', rate: '20', output: 'net', decimals: '2'})).isEqualTo(10);
- name: Zero decimal places
  code: |-
    assertThat(runCode({amount: '1000', mode: 'rate', rate: '20', output: 'net', decimals: '0'})).isEqualTo(833);


