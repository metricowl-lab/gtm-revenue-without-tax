___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const makeNumber = require('makeNumber');
const getType = require('getType');
const Math = require('Math');

// Only numbers, or strings that are numbers, count. Blank strings, true/false, NaN and infinity don't.
const isFinite = function (n) {
  // n - n is NaN for NaN and for infinity, and 0 for every other number.
  return getType(n) === 'number' && n - n === 0;
};
const toNumber = function (value) {
  const type = getType(value);
  if (type !== 'number' && type !== 'string') return undefined;
  if (type === 'string') {
    // Plain numbers only, so text such as 0x10 isn't read as 16.
    let blank = true;
    for (let i = 0; i < value.length; i++) {
      const c = value.charAt(i);
      if (' \t\r\n'.indexOf(c) > -1) continue;
      if ('0123456789.-+eE'.indexOf(c) === -1) return undefined;
      blank = false;
    }
    if (blank) return undefined;
  }
  const n = makeNumber(value);
  return isFinite(n) ? n : undefined;
};

const gross = toNumber(data.amount);
if (gross === undefined) return undefined;

let decimals = toNumber(data.decimals);
if (decimals === undefined || decimals < 0) decimals = 2;
decimals = Math.floor(decimals > 10 ? 10 : decimals);
const factor = Math.pow(10, decimals);

// Round half away from zero, so refunds round the same way as sales.
const roundUnits = function (n) {
  return n < 0 ? -Math.round(-n) : Math.round(n);
};

// Work in whole units (pence or cents), so floating-point error can't tip a half-penny the wrong
// way, and the amount without tax plus the tax always adds back up to the original amount.
const grossUnits = roundUnits(gross * factor);
let netUnits;
if (data.mode === 'taxValue') {
  const tax = toNumber(data.taxValue);
  if (tax === undefined) return undefined;
  netUnits = grossUnits - roundUnits(tax * factor);
} else {
  const rate = toNumber(data.rate);
  if (rate === undefined || rate < 0) return undefined;
  netUnits = roundUnits(grossUnits * 100 / (100 + rate));
}

const units = data.output === 'tax' ? grossUnits - netUnits : netUnits;
const result = units / factor;
// Amounts too large to handle exactly overflow; return nothing rather than a wrong number.
return isFinite(result) ? result : undefined;


